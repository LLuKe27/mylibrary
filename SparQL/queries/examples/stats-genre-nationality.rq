# Exemplo didático: quantidade de obras por gênero e nacionalidade do autor.

PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX schema: <https://schema.org/>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>

SELECT ?genreLabel ?nationality (COUNT(?book) AS ?total)
WHERE {
  ?book a schema:Book ;
        dct:creator ?author ;
        schema:genre ?genre .
  ?genre skos:prefLabel ?genreLabel .
  ?author schema:nationality ?nationality .
}
GROUP BY ?genreLabel ?nationality
ORDER BY DESC(?total) ?genreLabel

