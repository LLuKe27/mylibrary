    schema:encodingFormat "audio/wav" ;
    schema:duration "PT110S"^^xsd:duration .

<https://biblioteca.grupo9.example/resource/book/iracema>
    a schema:Book ;
    lib:slug "iracema" ;
    dct:title "Iracema"@pt ;
    dct:creator <https://biblioteca.grupo9.example/resource/author/jose-de-alencar> ;
    schema:genre <https://biblioteca.grupo9.example/resource/genre/romantismo> ;
    dct:issued "1865"^^xsd:gYear ;
    schema:numberOfPages "128"^^xsd:integer ;
    schema:abstract "A virgem dos lábios de mel, guardiã do segredo da jurema, apaixona-se pelo guerreiro português Martim. Lenda poética sobre a origem do Ceará, o romance simboliza o encontro — e o conflito — entre o nativo e o colonizador."@pt ;
    lib:coverPalette "#0f5257,#f2a65a,#fff7e8" ;
    lib:coverMotif "leaves" ;
    lib:searchText "iracema jose de alencar romantismo" ;
    schema:audio <https://biblioteca.grupo9.example/resource/audio/iracema> .

