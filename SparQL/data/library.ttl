<https://biblioteca.grupo9.example/resource/book/o-guarani>
    a schema:Book ;
    lib:slug "o-guarani" ;
    dct:title "O Guarani"@pt ;
    dct:creator <https://biblioteca.grupo9.example/resource/author/jose-de-alencar> ;
    schema:genre <https://biblioteca.grupo9.example/resource/genre/romantismo> ;
    dct:issued "1857"^^xsd:gYear ;
    schema:numberOfPages "352"^^xsd:integer ;
    schema:abstract "No século XVII, às margens do Paquequer, o indígena Peri dedica sua lealdade a Cecília, filha do fidalgo D. Antônio de Mariz. Entre ataques, traições e uma natureza grandiosa, o romance constrói um mito de fundação nacional."@pt ;
    lib:coverPalette "#203a2b,#d9c26b,#f4f1e6" ;
