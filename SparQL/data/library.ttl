<https://biblioteca.grupo9.example/resource/book/dom-casmurro>
    a schema:Book ;
    lib:slug "dom-casmurro" ;
    dct:title "Dom Casmurro"@pt ;
    dct:creator <https://biblioteca.grupo9.example/resource/author/machado-de-assis> ;
    schema:genre <https://biblioteca.grupo9.example/resource/genre/realismo> ;
    dct:issued "1899"^^xsd:gYear ;
    schema:numberOfPages "256"^^xsd:integer ;
    schema:abstract "Bento Santiago, já maduro e solitário, revisita a juventude para tentar unir as pontas da vida. Narra o amor por Capitu, a amizade com Escobar e a dúvida que corrói tudo: teria sido traído? Um narrador pouco confiável conduz o leitor por um dos maiores enigmas da literatura brasileira."@pt ;
    lib:coverPalette "#1d2a44,#e9b44c,#f5efe0" ;
    lib:coverMotif "eyes" ;
    lib:searchText "dom casmurro machado de assis realismo" ;
    schema:audio <https://biblioteca.grupo9.example/resource/audio/dom-casmurro> .

<https://biblioteca.grupo9.example/resource/audio/dom-casmurro>
    a schema:AudioObject ;
    schema:contentUrl "/api/audio/dom-casmurro" ;
    schema:encodingFormat "audio/wav" ;
    schema:duration "PT120S"^^xsd:duration .

<https://biblioteca.grupo9.example/resource/book/memorias-postumas>
    a schema:Book ;
    lib:slug "memorias-postumas" ;
    dct:title "Memórias Póstumas de Brás Cubas"@pt ;
    dct:creator <https://biblioteca.grupo9.example/resource/author/machado-de-assis> ;
    schema:genre <https://biblioteca.grupo9.example/resource/genre/realismo> ;
    dct:issued "1881"^^xsd:gYear ;
    schema:numberOfPages "224"^^xsd:integer ;
    schema:abstract "Um defunto autor decide contar a própria vida depois de morto. Com ironia e pessimismo, Brás Cubas expõe a vaidade, as ambições frustradas e os amores mal resolvidos da elite carioca do século XIX, inaugurando o Realismo no Brasil."@pt ;
    lib:coverPalette "#2b2b2b,#c94f4f,#f2f2f2" ;
    lib:coverMotif "circles" ;
    lib:searchText "memorias postumas de bras cubas machado de assis realismo" ;
    schema:audio <https://biblioteca.grupo9.example/resource/audio/memorias-postumas> .

<https://biblioteca.grupo9.example/resource/audio/memorias-postumas>
    a schema:AudioObject ;
